<h2>Login</h2>

<form id="loginForm">
  <input 
    type="email" 
    name="email" 
    placeholder="Email" 
    required
  />

  <input 
    type="password" 
    name="password" 
    placeholder="Contraseña" 
    required
  />
<a href="/register">Crear usuario</a>
