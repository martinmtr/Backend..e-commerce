<h1>Todos nuestros Productos</h1>
<li><a href="/login" class="btn-log">Iniciar o crear usuario</a></li>
{{#if category}}
  <h2>Categoría: {{category}}</h2>
{{/if}}

<div class="products-grid">
  {{#each products}}
    <div class="product-card">

      {{#if this.thumbnails.length}}
        <img src="{{this.thumbnails.[0]}}" alt="{{this.title}}">
      {{else}}
        <img src="/img/{{this.thumbnails}}" alt="{{this.title}}">
      {{/if}}

      <h3>{{this.title}}</h3>
      <p>Precio: ${{this.price}}</p>

      <button class="carrito" onclick="addToCart('{{this._id}}')">
        Agregar al Carrito
      </button>

      <button
        class="detalle"
        onclick="showDetails('{{this.title}}', '{{this.description}}', '{{this.category}}', '{{this.stock}}')">
        🔍 Ver detalles
      </button>

    </div>
  {{else}}
    <p>No hay productos para mostrar</p>
  {{/each}}
</div>

<!-- PAGINACIÓN -->
<div style="margin-top: 20px;">
  {{#each links}}
    <a href="{{this.link}}" style="margin: 0 5px;">
      {{this.text}}
    </a>
  {{/each}}
</div>

<!-- CARRITO  -->
<h2>Carrito</h2>
<div id="cart">
  <p>El carrito está vacío</p>
</div>

<!-- SWEETALERT -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/products.js"></script>
<script src="/js/carts.js"></script>